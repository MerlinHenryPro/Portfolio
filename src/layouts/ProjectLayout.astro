---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  rubrique: string;
  tag: string;
  tagCom?: boolean;
  lead: string;
}
const { title, description, rubrique, tag, tagCom, lead } = Astro.props;
---
<BaseLayout title={`${title} — Merlin HENRY`} description={description} page="projets">
  <main id="contenu">
    <article class="container-site flex flex-col gap-[clamp(70px,10vw,120px)] pt-[clamp(50px,8vw,100px)] pb-[clamp(90px,12vw,150px)]" style="--w:1114px">
      <header class="flex flex-col gap-5">
        <p class="eyebrow mb-5 tracking-[0.14em]"><a href="/projets/" class="hover:text-gold">Réalisations</a> &gt; {rubrique}</p>
        <span class:list={["tag self-start border-[1.4px] px-5 py-1 text-[0.93rem]", tagCom && "tag-com"]}>{tag}</span>
        <h1 class="text-[clamp(2.4rem,1rem+5vw,4.35rem)] leading-[1.1]">{title}</h1>
        <p class="text-[clamp(1.15rem,1rem+0.8vw,1.55rem)] leading-[1.55]">{lead}</p>
      </header>
      <slot />
    </article>
  </main>
</BaseLayout>
