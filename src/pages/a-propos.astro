---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutBody from "../components/AboutBody.astro";
---
<BaseLayout title="À propos — Merlin HENRY" description="Ce site est le portfolio de Merlin HENRY : biographie, compétences, projets et créations." page="a-propos">
  <main id="contenu" class="container-site py-[clamp(50px,8vw,100px)] pb-[clamp(80px,12vw,120px)]" style="--w:1114px">
    <AboutBody titre="Quel est ce site ?" paragraphes={[
      "Ce site est un portfolio ayant pour but de présenter mes travaux et ma personne et les mettre en avant comme une vitrine.",
      "Sur ce site, il est possible de trouver ma biographie, mes compétences ainsi que mes projets et créations.",
    ]} />
  </main>
</BaseLayout>
