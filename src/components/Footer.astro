---
const liens = [
  { href: "/", label: "Accueil" },
  { href: "/projets/", label: "Projets" },
  { href: "/biographie/", label: "Biographie" },
  { href: "/a-propos/", label: "À propos" },
];
const reseaux = [
  { href: "https://www.behance.net/Merlin_HENRY", label: "Behance ↗" },
  { href: "https://www.linkedin.com/in/merlin-henry-16a010396", label: "LinkedIn ↗" },
  { href: "https://github.com/MerlinHenryPro", label: "GitHub ↗" },
];
const annee = new Date().getFullYear();
---
<footer class="border-t border-gold/10 bg-deep px-4 py-[60px] sm:px-10">
  <div class="mx-auto flex w-full max-w-[1194px] flex-col items-start justify-between gap-8 md:flex-row md:items-center">
    <div>
      <a href="/" class="font-serif text-[1.37rem] font-semibold text-gold">Merlin HENRY</a>
      <p class="pt-2 text-slate">Création</p>
    </div>
    <nav aria-label="Navigation du pied de page" class="flex flex-wrap gap-x-6 gap-y-2 md:flex-col md:items-end md:gap-3">
      {liens.map((l) => <a href={l.href} class="text-[1.0625rem] font-medium uppercase tracking-[0.05em] text-slate transition hover:text-gold">{l.label}</a>)}
    </nav>
  </div>
  <div class="mx-auto mt-10 flex w-full max-w-[1194px] flex-col items-start justify-between gap-4 border-t border-gold/10 pt-[30px] text-[0.9rem] text-slate md:flex-row md:flex-wrap md:items-center">
    <div class="leading-normal opacity-60">
      <a href="/mentions-legales/" class="hover:text-gold">Mentions légales</a>
      <p>{annee} | Tous droits réservés</p>
    </div>
    <div class="flex flex-wrap gap-3">
      {reseaux.map((r) => <a href={r.href} target="_blank" rel="noopener" class="chip">{r.label}</a>)}
    </div>
    <a href="mailto:henrymerlin.pro@gmail.com" class="opacity-60 transition hover:text-gold hover:opacity-100">Henrymerlin.pro@gmail.com</a>
  </div>
</footer>
