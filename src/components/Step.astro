---
// Une étape d'article de projet : petit numéro doré + titre + contenu
interface Props { num?: string; titre: string; id: string }
const { num, titre, id } = Astro.props;
---
<section class="flex flex-col gap-10" aria-labelledby={id}>
  <div class="flex flex-col gap-[15px]">
    {num && <p class="text-[0.93rem] font-semibold uppercase leading-[1.3] tracking-[0.08em] text-gold">{num}</p>}
    <h2 id={id} class="text-[clamp(1.75rem,1rem+2.6vw,2.5rem)] leading-[1.25]">{titre}</h2>
  </div>
  <slot />
</section>
