---
import { categories, type Projet } from "../data/projets";
interface Props { projet: Projet }
const { projet: p } = Astro.props;
---
<a href={`/projets/${p.slug}/`}
  class="group flex h-full flex-col overflow-clip rounded-[20px] border border-gold/10 bg-navy transition duration-300 hover:-translate-y-[3px] hover:border-gold/28 hover:shadow-[0_18px_40px_-20px_rgba(0,0,0,0.8)]">
  <div class="relative aspect-[353/218] overflow-hidden bg-midnight">
    <img src={p.image} alt={p.alt} loading="lazy" decoding="async"
      class="size-full object-cover transition duration-500 group-hover:scale-[1.04] group-hover:!opacity-100"
      style={`opacity:${p.opacite ?? 0.86};${p.cadrage ? `object-position:${p.cadrage}` : ""}`} />
    <span class:list={["tag absolute left-3.5 top-3.5", p.categorie === "communication" && "tag-com"]}>{categories[p.categorie]}</span>
  </div>
  <div class="flex-1 px-6 pb-[17px] pt-5">
    <p class="text-[0.85rem] uppercase tracking-[0.06em] text-slate">{p.date}</p>
    <h3 class="pt-[7px] text-[1.3rem] leading-tight">{p.titre}</h3>
    <p class="pt-[9px] text-[1.05rem] leading-normal opacity-75">{p.texte}</p>
  </div>
  <div class="flex items-center justify-between border-t border-gold/10 px-6 py-[13px] font-medium text-gold">
    <span>Lire l’article</span>
    <span aria-hidden="true" class="text-xl transition group-hover:translate-x-1">→</span>
  </div>
</a>
